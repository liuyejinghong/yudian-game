config_version=5

[application]

config/name="Yudian"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.7", "C#")

[dotnet]

project/assembly_name="Yudian"

[rendering]

renderer/rendering_method="forward_plus"
textures/vram_compression/import_etc2_astc=true
