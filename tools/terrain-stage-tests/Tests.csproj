<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <NuGetAudit>false</NuGetAudit>
    <UseAppHost>false</UseAppHost>
    <AssemblyName>TerrainStage.Tests</AssemblyName>
    <RootNamespace>TerrainStage.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- T3b-MESH：共享数据+共享几何+本候选目录源码链接编译进本测试程序集，零外部包、不建类库工程。 -->
    <Compile Include="../../prototype/scripts/TerrainData/*.cs" Link="TerrainData/%(Filename)%(Extension)" />
    <Compile Include="../../prototype/scripts/TerrainGeometry/*.cs" Link="TerrainGeometry/%(Filename)%(Extension)" />
    <Compile Include="../../prototype/scripts/TerrainCandidates/StageGrid/*.cs" Link="StageGrid/%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
